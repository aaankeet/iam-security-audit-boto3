# Local .terraform directories (contains heavy provider binaries)
**/.terraform/*

# .tfstate files (contain sensitive infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore saved plan files
*.tfplan

# Custom project files
*.env
.env*
auditor.zip
